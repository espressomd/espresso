# Feature definitions
#
# The definitions are used for
# * generation of config-features.hpp, which checks the sanity of
#   the various features and their combinations
# * generation of myconfig-sample.hpp
#
# Lines commented with '/* ... */' or '//' are copied to myconfig-sample.hpp
# Lines commented with '#' are ignored

/* Generic features */
EXTERNAL_FORCES
MASS
EXCLUSIONS
BOND_CONSTRAINT
THERMOSTAT_PER_PARTICLE
COLLISION_DETECTION
NPT
ENGINE                          implies ROTATION, EXTERNAL_FORCES
PARTICLE_ANISOTROPY             implies ROTATION
STOKESIAN_DYNAMICS              implies ROTATION
H5MD
HDF5                            implies H5MD

/* Rotation */
ROTATION
ROTATIONAL_INERTIA              implies ROTATION

/* Electrostatics */
ELECTROSTATICS
P3M                             equals ELECTROSTATICS and FFTW
MMM1D                           equals ELECTROSTATICS and GSL
WALBERLA_FFT                    equals WALBERLA and FFTW

/* Magnetostatics */
DIPOLES                         implies ROTATION
DP3M                            equals DIPOLES and FFTW
DIPOLE_FIELD_TRACKING           implies DIPOLES
THERMAL_STONER_WOHLFARTH        requires NLOPT
THERMAL_STONER_WOHLFARTH        implies VIRTUAL_SITES_RELATIVE, DIPOLE_FIELD_TRACKING

/* Virtual sites features */
VIRTUAL_SITES
VIRTUAL_SITES_RELATIVE          implies VIRTUAL_SITES, ROTATION
VIRTUAL_SITES_CENTER_OF_MASS    implies VIRTUAL_SITES, MASS
VIRTUAL_SITES_INERTIALESS_TRACERS implies VIRTUAL_SITES

/* DPD features */
DPD

/* Lattice-Boltzmann features */
LB_ELECTROHYDRODYNAMICS

/* Interaction features */
TABULATED
LENNARD_JONES
WCA
LENNARD_JONES_GENERIC           implies LENNARD_JONES
LJCOS
LJCOS2
LJGEN_SOFTCORE                  implies LENNARD_JONES_GENERIC
SMOOTH_STEP
HERTZIAN
GAUSSIAN
BMHTF_NACL
MORSE
BUCKINGHAM
SOFT_SPHERE
HAT
GAY_BERNE                       implies ROTATION
THOLE                           requires ELECTROSTATICS

/* ScaFaCoS */
SCAFACOS_DIPOLES                requires SCAFACOS
SCAFACOS_DIPOLES                implies DIPOLES
SCAFACOS                        requires ELECTROSTATICS
SCAFACOS                        requires not FPE

/* Debugging */
ADDITIONAL_CHECKS

# External switches
# Switches that are set by the build system, not to be set manually
# All these switches must also be present in cmake/espresso_cmake_config.cmakein
CUDA external
FFTW external
HDF5 external
SCAFACOS external
GSL external
STOKESIAN_DYNAMICS external
NLOPT external
WALBERLA external
VALGRIND external
CALIPER external
FPE external
SHARED_MEMORY_PARALLELISM external
